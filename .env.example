# Electrolyser Telemetry — Environment Template
# Copy this file to .env and fill in your own secrets before running.
#
#   cp .env.example .env
#   $EDITOR .env
#
# NEVER commit .env — it is in .gitignore.

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-influxdb-password
INFLUXDB_ORG=electrolyser-org
INFLUXDB_BUCKET=telemetry
# Generate a strong token, e.g.:  openssl rand -hex 32
INFLUX_TOKEN=change-me-generate-a-strong-token

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-grafana-password

# ── MQTT WebSocket viewer (port 9001, React SCADA UI) ────────────────────────
# After 'make up', run 'make init-pwfile' to write the hashed entry to pwfile.
MQTT_WS_USER=ws_viewer
MQTT_WS_PASS=change-me-websocket-password
